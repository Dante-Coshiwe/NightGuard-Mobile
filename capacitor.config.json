{
  "appId": "com.nightguard.nightguardtrack",
  "appName": "NightGuard Track",
  "webDir": "dist",
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "directUpdate": false,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "appReadyTimeout": 20000,
      "statsUrl": ""
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "server": {
    "androidScheme": "https"
  }
}
